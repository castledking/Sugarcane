+    // Sugarcane start - Optimise villager AI - remember each column's poi chunk for the length of one PoiAccess search
+    // get and getOrLoad look the chunk holder up again for every section, and a 48 block villager search visits up to
+    // 7x7 columns of 24 sections each. Chunk holders are only removed while the chunk system ticks, so a loaded poi
+    // chunk is the same object for the whole search, including one this search had to load itself.
+    public SearchSections sugarcane$searchSections(final int lowerX, final int lowerZ, final int upperX, final int upperZ) {
+        return new SearchSections(lowerX, lowerZ, upperX, upperZ);
+    }
+
+    public final class SearchSections {
+        private final int lowerX;
+        private final int lowerZ;
+        private final int sizeX;
+        private final int sizeZ;
+        private final ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk[] chunks;
+
+        private SearchSections(final int lowerX, final int lowerZ, final int upperX, final int upperZ) {
+            this.lowerX = lowerX;
+            this.lowerZ = lowerZ;
+            this.sizeX = upperX - lowerX + 1;
+            this.sizeZ = upperZ - lowerZ + 1;
+            this.chunks = new ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk[this.sizeX * this.sizeZ];
+        }
+
+        private int index(final int chunkX, final int chunkZ) {
+            final int offsetX = chunkX - this.lowerX;
+            final int offsetZ = chunkZ - this.lowerZ;
+            return offsetX < 0 || offsetX >= this.sizeX || offsetZ < 0 || offsetZ >= this.sizeZ ? -1 : offsetX + offsetZ * this.sizeX;
+        }
+
+        private ca.spottedleaf.moonrise.patches.chunk_system.level.poi.@org.jspecify.annotations.Nullable PoiChunk getPoiChunkIfLoaded(
+            final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager manager, final int chunkX, final int chunkZ
+        ) {
+            final int index = this.index(chunkX, chunkZ);
+            if (index < 0) {
+                return manager.getPoiChunkIfLoaded(chunkX, chunkZ, true);
+            }
+            ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk chunk = this.chunks[index];
+            if (chunk == null) {
