+    private int sugarcane$collectRunning(final BehaviorControl<? super E>[] into) {
+        int count = 0;
+        for (final BehaviorControl<? super E> behavior : this.sugarcane$allBehaviours) {
+            if (behavior.getStatus() == Behavior.Status.RUNNING) {
+                into[count++] = behavior;
+            }
+        }
+        return count;
+    }
+
+    private void sugarcane$returnRunningScratch(final BehaviorControl<? super E>[] scratch, final int count) {
+        java.util.Arrays.fill(scratch, 0, count, null);
+        this.sugarcane$runningScratch = scratch;
+    }
+    // Sugarcane end - Optimise brain ticking
 
